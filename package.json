{
  "name": "awesome-latam-vc-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run index",
    "index": "pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "a11y": "html-validate \"dist/**/*.html\"",
    "seo-audit": "node scripts/verify-seo.mjs",
    "smoke": "node scripts/smoke-site.mjs",
    "verify-build": "node scripts/verify-build.mjs",
    "verify": "npm run check && npm run test && npm run verify-build && npm run a11y"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@types/node": "26.1.1",
    "html-validate": "11.5.6",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
