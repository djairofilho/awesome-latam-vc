{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-207/schemas/identity-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "subject_ids", "canonical_candidate_id", "brand_id", "manager_id", "vehicle_ids", "resolution", "reason", "evidence_ids", "resolved_on", "resolver"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resolution_id": {"type": "string", "pattern": "^identity-fund-br-[a-z0-9][a-z0-9-]*$"},
    "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^fund-br-[a-z0-9][a-z0-9-]*$"}},
    "canonical_candidate_id": {"type": ["string", "null"], "pattern": "^fund-br-[a-z0-9][a-z0-9-]*$"},
    "brand_id": {"type": ["string", "null"], "pattern": "^brand-[a-z0-9][a-z0-9-]*$"},
    "manager_id": {"type": ["string", "null"], "pattern": "^manager-[a-z0-9][a-z0-9-]*$"},
    "vehicle_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^vehicle-[a-z0-9][a-z0-9-]*$"}},
    "resolution": {"enum": ["same_identity", "brand_alias", "successor", "distinct_vehicle", "distinct_organization", "unresolved"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev-fund-br-[a-z0-9][a-z0-9-]*$"}},
    "resolved_on": {"type": "string", "format": "date"},
    "resolver": {"type": "string", "minLength": 1}
  }
}
