{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-207/schemas/candidate.schema.json",
  "title": "Brazil funds re-audit candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "name", "brand_id", "manager_id", "vehicle_ids", "program_ids", "successor_id", "canonical_candidate_id", "canonical_profile", "aliases", "entity_type", "canonical_domain", "official_site", "base_country", "brazil_relation", "direct_startup_investment", "recurring_vc", "activity_status", "latest_official_activity_on", "cutoff_date", "discovery_source_ids", "official_evidence_ids", "discovered_on", "status", "decision", "reason", "destination", "owner", "next_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^fund-br-[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "brand_id": {"type": ["string", "null"], "pattern": "^brand-[a-z0-9][a-z0-9-]*$"},
    "manager_id": {"type": ["string", "null"], "pattern": "^manager-[a-z0-9][a-z0-9-]*$"},
    "vehicle_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^vehicle-[a-z0-9][a-z0-9-]*$"}},
    "program_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^program-[a-z0-9][a-z0-9-]*$"}},
    "successor_id": {"type": ["string", "null"], "pattern": "^fund-br-[a-z0-9][a-z0-9-]*$"},
    "canonical_candidate_id": {"type": ["string", "null"], "pattern": "^fund-br-[a-z0-9][a-z0-9-]*$"},
    "canonical_profile": {"type": ["string", "null"], "pattern": "^funds/[a-z0-9._/-]+\\.md$"},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entity_type": {"enum": ["brand", "manager", "vehicle", "fund", "investment_organization", "unknown"]},
    "canonical_domain": {"type": ["string", "null"], "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"},
    "official_site": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
    "base_country": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
    "brazil_relation": {"enum": ["based_in_brazil", "accessible_to_brazil", "brazil_incidental", "brazil_unconfirmed"]},
    "direct_startup_investment": {"type": ["boolean", "null"]},
    "recurring_vc": {"type": ["boolean", "null"]},
    "activity_status": {"enum": ["active", "inactive", "unknown"]},
    "latest_official_activity_on": {"type": ["string", "null"], "format": "date"},
    "cutoff_date": {"type": "string", "format": "date"},
    "discovery_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-fund-br-[a-z0-9][a-z0-9-]*$"}},
    "official_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev-fund-br-[a-z0-9][a-z0-9-]*$"}},
    "discovered_on": {"type": "string", "format": "date"},
    "status": {"enum": ["discovered", "researching", "decided", "published"]},
    "decision": {"type": ["string", "null"], "enum": ["eligible", "duplicate", "routed_accelerators", "routed_angel_networks", "routed_funding_platforms", "routed_public_programs", "routed_other", "inactive", "insufficient_evidence", "excluded", null]},
    "reason": {"type": ["string", "null"], "minLength": 1},
    "destination": {"type": ["string", "null"], "minLength": 1},
    "owner": {"type": ["string", "null"], "minLength": 1},
    "next_action": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {"if": {"required": ["status"], "properties": {"status": {"enum": ["discovered", "researching"]}}}, "then": {"properties": {"decision": {"type": "null"}}}},
    {"if": {"required": ["status"], "properties": {"status": {"enum": ["decided", "published"]}}}, "then": {"properties": {"decision": {"type": "string"}}}},
    {"if": {"required": ["decision"], "properties": {"decision": {"const": "eligible"}}}, "then": {"properties": {"official_site": {"type": "string"}, "direct_startup_investment": {"const": true}, "recurring_vc": {"const": true}, "activity_status": {"const": "active"}, "brazil_relation": {"enum": ["based_in_brazil", "accessible_to_brazil"]}, "official_evidence_ids": {"minItems": 1}}}},
    {"if": {"required": ["decision"], "properties": {"decision": {"enum": ["duplicate", "routed_accelerators", "routed_angel_networks", "routed_funding_platforms", "routed_public_programs", "routed_other", "inactive", "insufficient_evidence", "excluded"]}}}, "then": {"properties": {"reason": {"type": "string"}}}},
    {"if": {"required": ["decision"], "properties": {"decision": {"const": "insufficient_evidence"}}}, "then": {"properties": {"owner": {"type": "string"}, "next_action": {"type": "string"}, "reason": {"type": "string"}}}},
    {"if": {"required": ["decision"], "properties": {"decision": {"enum": ["routed_accelerators", "routed_angel_networks", "routed_funding_platforms", "routed_public_programs", "routed_other"]}}}, "then": {"properties": {"destination": {"type": "string"}, "reason": {"type": "string"}}}}
  ]
}
