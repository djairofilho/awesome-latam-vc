{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-64/schemas/evidence.schema.json",
  "title": "Evidência de plataforma da epic 64",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "platform_id",
    "subject_type",
    "subject_id",
    "url",
    "title",
    "publisher",
    "source_type",
    "published_on",
    "accessed_on",
    "claims",
    "locator",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[a-z0-9][a-z0-9-]*$"
    },
    "platform_id": {
      "type": "string",
      "pattern": "^plat-[a-z0-9][a-z0-9-]*$"
    },
    "subject_type": {
      "enum": ["operator", "brand", "platform", "product", "offer", "regulatory_record"]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(op|brand|plat|prod|offer|reg)-[a-z0-9][a-z0-9-]*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "source_type": {
      "enum": [
        "official_platform",
        "official_operator",
        "official_regulator",
        "official_document",
        "third_party"
      ]
    },
    "published_on": {
      "type": ["string", "null"],
      "format": "date"
    },
    "accessed_on": { "type": "string", "format": "date" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "finding"],
        "properties": {
          "field": {
            "enum": [
              "legal_operator",
              "brand_relationship",
              "structured_founder_route",
              "latam_access",
              "recent_activity",
              "product_instrument",
              "offer_status",
              "regulatory_status",
              "geography"
            ]
          },
          "finding": {
            "enum": ["confirmed", "refuted", "not_disclosed"]
          }
        }
      }
    },
    "locator": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 }
  }
}
