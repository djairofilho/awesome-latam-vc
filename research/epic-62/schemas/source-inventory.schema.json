{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-62/schemas/source-inventory.schema.json",
  "title": "Fonte inventariada de aceleradoras",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "issue",
    "source",
    "initial_url",
    "category",
    "countries",
    "scope_walked",
    "accessed_on",
    "result",
    "reason",
    "owner",
    "next_action",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": {
      "type": "string",
      "pattern": "^src-accel-[a-z0-9][a-z0-9-]*$"
    },
    "issue": {
      "type": "integer",
      "enum": [70, 71, 72, 73, 74, 75, 76, 77, 78, 79]
    },
    "source": { "type": "string", "minLength": 1 },
    "initial_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "category": {
      "enum": [
        "association",
        "corporate",
        "government",
        "institutional",
        "international",
        "directory",
        "university",
        "other"
      ]
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "scope_walked": { "type": "string", "minLength": 1 },
    "accessed_on": { "type": "string", "format": "date" },
    "result": { "enum": ["completed", "partial", "unavailable"] },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "next_action": { "type": ["string", "null"], "minLength": 1 },
    "notes": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": { "enum": ["partial", "unavailable"] }
        }
      },
      "then": {
        "properties": {
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    }
  ]
}
