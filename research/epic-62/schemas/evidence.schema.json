{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-62/schemas/evidence.schema.json",
  "title": "Evidência de aceleradora",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "candidate_id",
    "entity_id",
    "url",
    "title",
    "publisher",
    "source_type",
    "published_on",
    "accessed_on",
    "claims",
    "locator",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-accel-[a-z0-9][a-z0-9-]*$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^accel-[a-z0-9][a-z0-9-]*$"
    },
    "entity_id": { "type": "string", "minLength": 1 },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["official", "third-party"] },
    "published_on": {
      "type": ["string", "null"],
      "format": "date"
    },
    "accessed_on": { "type": "string", "format": "date" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "finding"],
        "properties": {
          "field": {
            "enum": [
              "operator_identity",
              "program_identity",
              "structured_program",
              "activity",
              "external_access",
              "latam_access",
              "application_route",
              "format",
              "duration",
              "stage",
              "capital",
              "instrument",
              "equity",
              "investment_vehicle"
            ]
          },
          "finding": {
            "enum": [
              "confirmed",
              "contradictory",
              "inconclusive",
              "not_publicly_disclosed"
            ]
          }
        }
      }
    },
    "locator": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 }
  }
}
