{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-62/schemas/state-coverage.schema.json",
  "title": "Cobertura estadual de aceleradoras",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_coverage_id",
    "issue",
    "country",
    "subdivision_code",
    "subdivision_name",
    "source_ids",
    "candidate_ids",
    "status",
    "reason",
    "owner",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "state_coverage_id": {
      "type": "string",
      "pattern": "^state-coverage-accel-[a-z0-9][a-z0-9-]*$"
    },
    "issue": {
      "type": "integer",
      "enum": [71, 72, 73, 74, 75]
    },
    "country": { "const": "Brazil" },
    "subdivision_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "subdivision_name": { "type": "string", "minLength": 2 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^src-accel-[a-z0-9][a-z0-9-]*$"
      }
    },
    "candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^accel-[a-z0-9][a-z0-9-]*$"
      }
    },
    "status": {
      "enum": ["directly-walked", "national-only", "gap"]
    },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "next_action": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["national-only", "gap"] }
        }
      },
      "then": {
        "properties": {
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    }
  ]
}
