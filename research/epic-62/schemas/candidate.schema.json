{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-62/schemas/candidate.schema.json",
  "title": "Candidato de aceleradora",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "operator_id",
    "program_id",
    "investment_vehicle_id",
    "canonical_candidate_id",
    "name",
    "aliases",
    "entity_type",
    "official_site",
    "base_country",
    "accepted_geography",
    "program_format",
    "duration",
    "stage",
    "capital_offered",
    "instrument",
    "equity",
    "open_to_external_founders",
    "latam_access",
    "activity_status",
    "application_status",
    "application_url",
    "status",
    "decision",
    "reason",
    "destination",
    "discovery_source_ids",
    "official_evidence_ids",
    "discovered_on",
    "evidence_date",
    "owner",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": {
      "type": "string",
      "pattern": "^accel-[a-z0-9][a-z0-9-]*$"
    },
    "operator_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
    },
    "program_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}#[a-z0-9][a-z0-9-]*$"
    },
    "investment_vehicle_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._#-]*$"
    },
    "canonical_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^accel-[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "entity_type": {
      "enum": ["operator", "program", "investment_vehicle", "unknown"]
    },
    "official_site": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "base_country": { "type": ["string", "null"], "minLength": 2 },
    "accepted_geography": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "program_format": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "duration": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "stage": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "capital_offered": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "instrument": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "equity": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "open_to_external_founders": { "type": ["boolean", "null"] },
    "latam_access": {
      "enum": ["confirmed", "not_confirmed", "unknown"]
    },
    "activity_status": {
      "enum": ["active", "paused", "inactive", "unknown"]
    },
    "application_status": {
      "enum": [
        "open",
        "closed",
        "closed_between_cycles",
        "invite_only",
        "not_publicly_disclosed",
        "not_applicable"
      ]
    },
    "application_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "status": {
      "enum": ["descoberto", "em-pesquisa", "decidido", "publicado"]
    },
    "decision": {
      "type": ["string", "null"],
      "enum": [
        "elegível",
        "duplicado",
        "encaminhado-para-funds",
        "encaminhado-para-outra-epic",
        "inativo",
        "evidência-insuficiente",
        "excluído",
        null
      ]
    },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "destination": { "type": ["string", "null"], "minLength": 1 },
    "discovery_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src-accel-[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "official_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-accel-[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "discovered_on": { "type": "string", "format": "date" },
    "evidence_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "next_action": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["descoberto", "em-pesquisa"] }
        }
      },
      "then": { "properties": { "decision": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["decidido", "publicado"] }
        }
      },
      "then": { "properties": { "decision": { "type": "string" } } }
    },
    {
      "if": { "properties": { "decision": { "const": "elegível" } } },
      "then": {
        "properties": {
          "entity_type": { "const": "program" },
          "operator_id": { "type": "string" },
          "program_id": { "type": "string" },
          "official_site": { "type": "string" },
          "open_to_external_founders": { "const": true },
          "latam_access": { "const": "confirmed" },
          "activity_status": { "const": "active" },
          "official_evidence_ids": { "minItems": 1 },
          "evidence_date": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "duplicado" } } },
      "then": {
        "anyOf": [
          { "properties": { "canonical_candidate_id": { "type": "string" } } },
          { "properties": { "destination": { "type": "string" } } }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "encaminhado-para-funds",
              "encaminhado-para-outra-epic"
            ]
          }
        }
      },
      "then": { "properties": { "destination": { "type": "string" } } }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "duplicado",
              "encaminhado-para-funds",
              "encaminhado-para-outra-epic",
              "inativo",
              "evidência-insuficiente",
              "excluído"
            ]
          }
        }
      },
      "then": { "properties": { "reason": { "type": "string" } } }
    },
    {
      "if": {
        "properties": {
          "decision": { "const": "evidência-insuficiente" }
        }
      },
      "then": {
        "properties": {
          "owner": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    }
  ]
}
