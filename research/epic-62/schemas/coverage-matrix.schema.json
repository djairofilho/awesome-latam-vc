{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-62/schemas/coverage-matrix.schema.json",
  "title": "Matriz de cobertura de aceleradoras",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage_id",
    "issue",
    "country",
    "source_category",
    "planned_sources",
    "completed_sources",
    "status",
    "reason",
    "owner",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "coverage_id": {
      "type": "string",
      "pattern": "^coverage-accel-[a-z0-9][a-z0-9-]*$"
    },
    "issue": {
      "type": "integer",
      "enum": [70, 71, 72, 73, 74, 75]
    },
    "country": { "type": "string", "minLength": 2 },
    "source_category": {
      "enum": [
        "association",
        "corporate",
        "government",
        "institutional",
        "international",
        "directory",
        "university",
        "other"
      ]
    },
    "planned_sources": { "type": "integer", "minimum": 0 },
    "completed_sources": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["planned", "complete", "partial", "unavailable"] },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "next_action": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["partial", "unavailable"] }
        }
      },
      "then": {
        "properties": {
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    }
  ]
}
