{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-latam-vc.local/epic-327/official-evidence-record.schema.json",
  "title": "Official evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "candidate_id",
    "official_url",
    "source_title",
    "accessed_on",
    "source_kind",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "pattern": "^evidence-delta-[a-z0-9-]+$"},
    "candidate_id": {"type": "string", "pattern": "^delta-fund-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "official_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "source_title": {"type": "string", "minLength": 1},
    "accessed_on": {"type": "string", "format": "date"},
    "source_kind": {
      "enum": [
        "official_identity",
        "official_thesis",
        "official_portfolio",
        "official_activity",
        "official_application",
        "official_legal_notice"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "support"],
        "properties": {
          "field": {
            "enum": [
              "identity",
              "direct_startup_investment",
              "recurrence",
              "activity_date",
              "base_geography",
              "market_access",
              "founder_route",
              "portfolio",
              "category"
            ]
          },
          "value": {},
          "support": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
