{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-latam-vc.local/epic-327/publication-plan.schema.json",
  "title": "Auditable publication batch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "source_manifest",
    "source_manifest_sha256",
    "source_decisions_sha256",
    "review_records_sha256",
    "eligible_records_sha256",
    "cutoff_date",
    "batch_size_limit",
    "batch_count_formula",
    "eligible_count",
    "batch_count",
    "batches",
    "audit"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "issue": {"const": 338},
    "source_manifest": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_decisions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eligible_records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cutoff_date": {"type": "string", "format": "date"},
    "batch_size_limit": {"const": 10},
    "batch_count_formula": {"const": "ceil(eligible_count / 10)"},
    "eligible_count": {"type": "integer", "minimum": 0},
    "batch_count": {"type": "integer", "minimum": 0},
    "batches": {
      "type": "array",
      "items": {"$ref": "#/$defs/batch"}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "covered_candidate_count",
        "duplicate_candidate_ids",
        "duplicate_review_record_ids",
        "ineligible_batch_members",
        "unplanned_candidate_ids",
        "batch_size_limit_respected"
      ],
      "properties": {
        "covered_candidate_count": {"type": "integer", "minimum": 0},
        "duplicate_candidate_ids": {"type": "array", "maxItems": 0},
        "duplicate_review_record_ids": {"type": "array", "maxItems": 0},
        "ineligible_batch_members": {"type": "array", "maxItems": 0},
        "unplanned_candidate_ids": {"type": "array", "maxItems": 0},
        "batch_size_limit_respected": {"const": true}
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "canonical_name",
        "validation_partition",
        "decision",
        "decision_evidence_ids",
        "review_record_id",
        "record_sha256"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^delta-fund-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "canonical_name": {"type": "string", "minLength": 1},
        "validation_partition": {"type": "integer", "minimum": 0, "maximum": 2},
        "decision": {"const": "eligible"},
        "decision_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^evidence-delta-[a-z0-9-]+$"}
        },
        "review_record_id": {"type": "string", "minLength": 1},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "ordinal", "branch", "worktree", "candidate_count", "candidates"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^publication-batch-[0-9]{3}$"},
        "ordinal": {"type": "integer", "minimum": 1},
        "branch": {"type": "string", "pattern": "^feat/issue-338-batch-[0-9]{3}$"},
        "worktree": {"type": "string", "pattern": "^\\.worktrees/issue-338-batch-[0-9]{3}$"},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/member"}
        }
      }
    }
  }
}
