{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-latam-vc.local/epic-327/consolidated-candidate.schema.json",
  "title": "Consolidated LatAm delta candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "name",
    "aliases",
    "country_occurrences",
    "occurrence_count",
    "source_shards",
    "official_domains",
    "canonical_profile",
    "canonical_candidate_id",
    "category",
    "status",
    "route_destination",
    "evidence_ids",
    "validation_partition",
    "reducer_notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {
      "type": "string",
      "pattern": "^delta-fund-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "country_occurrences": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z]{2}$": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "occurrence_count": {"type": "integer", "minimum": 1},
    "source_shards": {
      "type": "array",
      "items": {
        "enum": [
          "triage-mexico-cac",
          "triage-andean",
          "triage-southern-cone-brazil"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "official_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "canonical_profile": {
      "type": ["string", "null"],
      "pattern": "^funds/.+\\.md$"
    },
    "canonical_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^delta-fund-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {"type": ["string", "null"]},
    "status": {
      "enum": [
        "duplicate",
        "routed",
        "ready_for_validation",
        "unresolved",
        "identity_conflict"
      ]
    },
    "route_destination": {"type": ["string", "null"]},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^evidence-delta-[a-z0-9-]+$"},
      "uniqueItems": true
    },
    "validation_partition": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 2
    },
    "reducer_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready_for_validation"}}},
      "then": {
        "properties": {
          "official_domains": {"minItems": 1},
          "evidence_ids": {"minItems": 1},
          "validation_partition": {"type": "integer"},
          "canonical_profile": {"type": "null"},
          "canonical_candidate_id": {"type": "null"}
        }
      },
      "else": {"properties": {"validation_partition": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "duplicate"}}},
      "then": {
        "anyOf": [
          {"properties": {"canonical_profile": {"type": "string"}}},
          {"properties": {"canonical_candidate_id": {"type": "string"}}}
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "routed"}}},
      "then": {"properties": {"route_destination": {"type": "string", "minLength": 1}}}
    }
  ]
}
