{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-65/schemas/evidence.schema.json",
  "title": "Evidência oficial da epic 65",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "subject_type",
    "subject_id",
    "url",
    "title",
    "publisher",
    "source_type",
    "published_on",
    "accessed_on",
    "claims",
    "locator",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-[a-z0-9][a-z0-9-]*$"
    },
    "subject_type": { "enum": ["agency", "program", "call"] },
    "subject_id": {
      "type": "string",
      "pattern": "^(agency|program|call)-[a-z0-9][a-z0-9-]*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "source_type": { "const": "oficial" },
    "published_on": { "type": ["string", "null"], "format": "date" },
    "accessed_on": { "type": "string", "format": "date" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "finding"],
        "properties": {
          "field": {
            "enum": [
              "tipo de entidade",
              "vínculo institucional",
              "benefício financeiro",
              "rota para startups",
              "atividade do programa",
              "recorrência",
              "status da chamada",
              "geografia",
              "elegibilidade",
              "valor",
              "contrapartida"
            ]
          },
          "finding": {
            "enum": ["confirmado", "refutado", "não divulgado"]
          }
        }
      },
      "uniqueItems": true
    },
    "locator": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 }
  }
}
