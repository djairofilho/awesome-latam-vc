{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-65/schemas/program.schema.json",
  "title": "Programa público da epic 65",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "agency_id",
    "name",
    "aliases",
    "official_url",
    "route_url",
    "geography",
    "program_kind",
    "benefit_types",
    "financial_benefit",
    "startup_route",
    "program_status",
    "activity_basis",
    "latest_official_signal_on",
    "assessed_on",
    "call_ids",
    "official_evidence_ids",
    "research_status",
    "decision",
    "canonical_program_id",
    "canonical_profile",
    "reason",
    "owner",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "program_id": {
      "type": "string",
      "pattern": "^program-[a-z0-9][a-z0-9-]*$"
    },
    "agency_id": {
      "type": "string",
      "pattern": "^agency-[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "official_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "route_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "geography": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "program_kind": {
      "enum": ["permanente", "recorrente", "temporário", "não confirmado"]
    },
    "benefit_types": {
      "type": "array",
      "items": {
        "enum": [
          "subvenção",
          "cofinanciamento",
          "crédito",
          "garantia",
          "capital",
          "instrumento conversível"
        ]
      },
      "uniqueItems": true
    },
    "financial_benefit": { "type": ["boolean", "null"] },
    "startup_route": { "type": ["boolean", "null"] },
    "program_status": {
      "enum": [
        "ativo",
        "fechado agora, recorrente",
        "inativo",
        "não confirmado"
      ]
    },
    "activity_basis": {
      "type": ["string", "null"],
      "enum": [
        "intake permanente",
        "chamada aberta",
        "recorrência oficial em 24 meses",
        "sem sinal suficiente",
        null
      ]
    },
    "latest_official_signal_on": {
      "type": ["string", "null"],
      "format": "date"
    },
    "assessed_on": { "type": "string", "format": "date" },
    "call_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^call-[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "official_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evidence-[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "research_status": {
      "enum": ["descoberto", "em pesquisa", "decidido", "publicado"]
    },
    "decision": {
      "type": ["string", "null"],
      "enum": [
        "elegível",
        "duplicado",
        "inativo",
        "evidência insuficiente",
        "excluído",
        null
      ]
    },
    "canonical_program_id": {
      "type": ["string", "null"],
      "pattern": "^program-[a-z0-9][a-z0-9-]*$"
    },
    "canonical_profile": {
      "type": ["string", "null"],
      "pattern": "^ecosystem/public-programs/.+\\.md$"
    },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "next_action": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "research_status": { "enum": ["descoberto", "em pesquisa"] }
        }
      },
      "then": { "properties": { "decision": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "research_status": { "enum": ["decidido", "publicado"] }
        }
      },
      "then": { "properties": { "decision": { "type": "string" } } }
    },
    {
      "if": { "properties": { "decision": { "const": "elegível" } } },
      "then": {
        "properties": {
          "official_url": { "type": "string" },
          "route_url": { "type": "string" },
          "program_kind": { "enum": ["permanente", "recorrente"] },
          "benefit_types": { "minItems": 1 },
          "financial_benefit": { "const": true },
          "startup_route": { "const": true },
          "program_status": {
            "enum": ["ativo", "fechado agora, recorrente"]
          },
          "activity_basis": {
            "enum": [
              "intake permanente",
              "chamada aberta",
              "recorrência oficial em 24 meses"
            ]
          },
          "latest_official_signal_on": { "type": "string" },
          "official_evidence_ids": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "duplicado" } } },
      "then": {
        "anyOf": [
          { "properties": { "canonical_program_id": { "type": "string" } } },
          { "properties": { "canonical_profile": { "type": "string" } } }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "duplicado",
              "inativo",
              "evidência insuficiente",
              "excluído"
            ]
          }
        }
      },
      "then": { "properties": { "reason": { "type": "string" } } }
    }
  ]
}
