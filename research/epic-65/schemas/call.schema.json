{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-65/schemas/call.schema.json",
  "title": "Chamada temporária da epic 65",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "program_id",
    "name",
    "official_url",
    "route_url",
    "call_status",
    "opened_on",
    "closes_on",
    "benefit_summary",
    "eligibility_summary",
    "official_evidence_ids",
    "captured_on",
    "profile_eligible",
    "canonical_profile"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "call_id": {
      "type": "string",
      "pattern": "^call-[a-z0-9][a-z0-9-]*$"
    },
    "program_id": {
      "type": "string",
      "pattern": "^program-[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "route_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "call_status": {
      "enum": ["aberta", "fechada", "prevista", "não confirmada"]
    },
    "opened_on": { "type": ["string", "null"], "format": "date" },
    "closes_on": { "type": ["string", "null"], "format": "date" },
    "benefit_summary": { "type": ["string", "null"], "minLength": 1 },
    "eligibility_summary": { "type": ["string", "null"], "minLength": 1 },
    "official_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^evidence-[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "captured_on": { "type": "string", "format": "date" },
    "profile_eligible": { "const": false },
    "canonical_profile": { "type": "null" }
  }
}
