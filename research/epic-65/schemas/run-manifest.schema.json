{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-65/schemas/run-manifest.schema.json",
  "title": "Registro de manifesto da epic 65",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "issue",
        "region",
        "cutoff_date",
        "status",
        "task_count",
        "coordinator",
        "scraping_performed"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "run" },
        "run_id": {
          "type": "string",
          "pattern": "^run-[a-z0-9][a-z0-9-]*$"
        },
        "issue": { "type": "integer", "minimum": 98, "maximum": 104 },
        "region": { "type": "string", "minLength": 1 },
        "cutoff_date": { "type": "string", "format": "date" },
        "status": { "enum": ["planejada", "em execução", "concluída", "bloqueada"] },
        "task_count": { "type": "integer", "minimum": 1 },
        "coordinator": { "type": "string", "minLength": 1 },
        "scraping_performed": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "task_id",
        "country",
        "source_type",
        "worker_id",
        "shard_path",
        "status",
        "reason",
        "next_action"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "task" },
        "run_id": {
          "type": "string",
          "pattern": "^run-[a-z0-9][a-z0-9-]*$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task-[a-z0-9][a-z0-9-]*$"
        },
        "country": { "type": "string", "minLength": 2 },
        "source_type": {
          "enum": [
            "agência de inovação",
            "ministério responsável",
            "banco público de desenvolvimento",
            "portal oficial de chamadas",
            "fonte subnacional oficial"
          ]
        },
        "worker_id": {
          "type": "string",
          "pattern": "^worker-[a-z0-9][a-z0-9-]*$"
        },
        "shard_path": {
          "type": "string",
          "pattern": "^research/epic-65/[^/]+/shards/[^/]+/$"
        },
        "status": { "enum": ["todo", "em execução", "done", "bloqueada"] },
        "reason": { "type": ["string", "null"], "minLength": 1 },
        "next_action": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "bloqueada" } } },
          "then": {
            "properties": {
              "reason": { "type": "string" },
              "next_action": { "type": "string" }
            }
          }
        }
      ]
    }
  ]
}
