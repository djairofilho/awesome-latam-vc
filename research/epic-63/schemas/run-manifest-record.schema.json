{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djairofilho/awesome-latam-vc/research/epic-63/schemas/run-manifest-record.schema.json",
  "title": "Registro de manifesto da epic 63",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/task" }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "issues",
        "contract_issue",
        "cutoff_date",
        "created_on",
        "status",
        "task_count",
        "scraping_performed",
        "max_global_requests",
        "max_requests_per_domain",
        "max_browsers",
        "owner",
        "notes"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "run" },
        "run_id": {
          "type": "string",
          "pattern": "^run-[a-z0-9][a-z0-9-]*$"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 81, "maximum": 88 }
        },
        "contract_issue": { "const": 80 },
        "cutoff_date": { "type": "string", "format": "date" },
        "created_on": { "type": "string", "format": "date" },
        "status": {
          "enum": ["planejada", "em execução", "concluída", "cancelada"]
        },
        "task_count": { "type": "integer", "minimum": 1 },
        "scraping_performed": { "type": "boolean" },
        "max_global_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_requests_per_domain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_browsers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "owner": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "task_id",
        "issue",
        "url",
        "task_type",
        "partition",
        "shard_path",
        "priority",
        "status",
        "owner",
        "next_action",
        "last_error"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "task" },
        "run_id": {
          "type": "string",
          "pattern": "^run-[a-z0-9][a-z0-9-]*$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task-[a-z0-9][a-z0-9-]*$"
        },
        "issue": { "type": "integer", "minimum": 81, "maximum": 88 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "task_type": {
          "enum": ["descoberta", "identidade", "evidência", "revisão"]
        },
        "partition": { "type": "string", "minLength": 1 },
        "shard_path": {
          "type": "string",
          "pattern": "^research/epic-63/.+/shards/[a-z0-9][a-z0-9-]*/$"
        },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "status": {
          "enum": [
            "todo",
            "leased",
            "extracted",
            "verified",
            "done",
            "blocked"
          ]
        },
        "owner": { "type": ["string", "null"], "minLength": 1 },
        "next_action": { "type": ["string", "null"], "minLength": 1 },
        "last_error": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["todo", "blocked"] } }
          },
          "then": {
            "properties": {
              "owner": { "type": "string" },
              "next_action": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } } },
          "then": { "properties": { "last_error": { "type": "string" } } }
        }
      ]
    }
  }
}
