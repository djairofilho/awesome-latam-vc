---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DirectoryExplorer from "../../components/DirectoryExplorer.astro";
import TranslationNotice from "../../components/TranslationNotice.astro";
import type { Locale } from "../../i18n/ui";
import { strings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizedCatalogItems } from "../../lib/catalog";
import {
  categoryRouteSuffix,
  countryDisplayName,
  countryRouteSuffix,
  directoryCountryCodes,
  directoryRecordForProfile,
} from "../../lib/directory-routes.mjs";
import {
  localeDetails,
  locales,
  localizedHref,
  localizedRoute,
} from "../../lib/i18n.mjs";
import {
  breadcrumbListJsonLd,
  datasetJsonLd,
  organizationJsonLd,
} from "../../lib/structured-data.mjs";

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: localeDetails(locale).route_segment },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const labels = strings(locale);
const profiles = localizedCatalogItems(
  await getCollection("profiles"),
  locale,
).sort((left, right) => left.name.localeCompare(right.name, locale));
const records = profiles.map((profile) =>
  directoryRecordForProfile(profile, locale),
);
const populatedCategories = Object.entries(labels.categoryLabels)
  .map(([category, label]) => ({
    category,
    label,
    count: records.filter(({ entity_type }) =>
      entity_type.includes(category),
    ).length,
  }))
  .filter(({ count }) => count > 0);
const countries = directoryCountryCodes(records).map((country) => ({
  code: country,
  label: countryDisplayName(locale, country),
  count: records.filter(({ geography }) => geography.includes(country)).length,
}));
const explorerLabels = {
  heading: labels.directoryHeading,
  searchLabel: labels.searchLabel,
  searchPlaceholder: labels.searchPlaceholder,
  clearFilters: labels.clearFilters,
  submitSearch: labels.submitSearch,
  facetLabels: labels.facetLabels,
  valueLabels: labels.categoryLabels,
  initialResults: labels.resultCount.replace(
    "{count}",
    String(records.length),
  ),
  resultCount: labels.resultCount,
  loading: labels.loadingResults,
  noResults: labels.noResults,
  error: labels.searchError,
  noScript: labels.noScript,
};
const catalogPath = localizedRoute(locale, "/catalog/");
const structuredData = [
  datasetJsonLd(profiles.length, catalogPath, locale),
  breadcrumbListJsonLd([
    { name: labels.home, path: localizedRoute(locale, "/") },
    { name: labels.catalog, path: catalogPath },
  ]),
  ...profiles.map(organizationJsonLd).filter(Boolean),
];
---

<BaseLayout
  title={labels.catalogTitle}
  description={labels.catalogDescription}
  canonicalPath={catalogPath}
  routeSuffix="/catalog/"
  locale={locale}
  structuredData={structuredData}
>
  <Breadcrumbs
    ariaLabel={labels.breadcrumbNavigation}
    items={[
      { label: labels.home, href: localizedHref(locale, "/") },
      { label: labels.catalog },
    ]}
  />
  <header class="page-intro">
    <p class="eyebrow">{labels.catalogKicker}</p>
    <h1>{labels.profileCount(profiles.length)}</h1>
    <p>{labels.catalogIntro}</p>
  </header>
  {
    locale !== "en" && (
      <TranslationNotice
        message={labels.translationNotice}
        correctionLabel={labels.suggestCorrection}
      />
    )
  }

  <div class="landing-navigation">
    <nav aria-labelledby="category-landings-heading">
      <h2 id="category-landings-heading">{labels.browseCategories}</h2>
      <ul>
        {
          populatedCategories.map(({ category, label, count }) => (
            <li>
              <a href={localizedHref(locale, categoryRouteSuffix(category))}>
                <span>{label}</span>
                <span>{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="country-landings-heading">
      <h2 id="country-landings-heading">{labels.browseCountries}</h2>
      <ul>
        {
          countries.map(({ code, label, count }) => (
            <li>
              <a href={localizedHref(locale, countryRouteSuffix(code))}>
                <span>{label}</span>
                <span>{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <DirectoryExplorer records={records} labels={explorerLabels} />
</BaseLayout>
