---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedHref } from "../lib/i18n.mjs";
import { webSiteJsonLd } from "../lib/structured-data.mjs";

const destinations = {
  en: localizedHref("en", "/"),
  "pt-BR": localizedHref("pt-BR", "/"),
  es: localizedHref("es", "/"),
};
---

<BaseLayout
  title="Awesome LatAm VC · Open funding directory"
  description="Open, source-backed directory of venture funds and startup funding programs across Latin America."
  canonicalPath="/"
  routeSuffix="/"
  structuredData={[webSiteJsonLd()]}
>
  <Fragment slot="head">
    <script is:inline define:vars={{ destinations }}>
      const preferredLanguage = (
        navigator.languages?.length
          ? navigator.languages
          : [navigator.language]
      )
        .map((language) => language?.toLowerCase())
        .find(
          (language) =>
            language?.startsWith("pt") ||
            language?.startsWith("es") ||
            language?.startsWith("en"),
        );
      const locale = preferredLanguage?.startsWith("pt")
        ? "pt-BR"
        : preferredLanguage?.startsWith("es")
          ? "es"
          : "en";
      window.location.replace(destinations[locale]);
    </script>
    <meta http-equiv="refresh" content={`0;url=${destinations.en}`} />
  </Fragment>

  <noscript>
    <p>
      Opening the directory in English.
      <a href={destinations.en}>Continue to the directory</a>.
    </p>
  </noscript>
</BaseLayout>
