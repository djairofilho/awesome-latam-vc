---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  localeDetails,
  locales,
  localizedHref,
} from "../lib/i18n.mjs";
import { webSiteJsonLd } from "../lib/structured-data.mjs";
---

<BaseLayout
  title="Awesome LatAm VC · Choose your language"
  description="Choose English, Portuguese or Spanish to browse the open Latin American funding directory."
  canonicalPath="/"
  routeSuffix="/"
  structuredData={[webSiteJsonLd()]}
>
  <section class="language-landing" aria-labelledby="language-heading">
    <p class="language-mark" aria-hidden="true">EN · PT-BR · ES</p>
    <h1 id="language-heading">Choose your language.</h1>
    <p>
      Escolha seu idioma. Elige tu idioma. The directory never redirects based
      on browser settings, and every option works without JavaScript.
    </p>
    <ul class="language-options">
      {
        locales.map((locale) => (
          <li>
            <a
              href={localizedHref(locale, "/")}
              lang={localeDetails(locale).html_lang}
            >
              <span>{localeDetails(locale).label}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
