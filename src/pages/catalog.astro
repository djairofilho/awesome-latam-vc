---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  localeDetails,
  locales,
  localizedCanonical,
  localizedHref,
} from "../lib/i18n.mjs";
---

<BaseLayout
  title="Catalog language · Awesome LatAm VC"
  description="Choose a language for the Awesome LatAm VC catalog."
  canonicalPath="/en/catalog/"
  routeSuffix="/catalog/"
  noindex
>
  <section class="language-landing" aria-labelledby="language-heading">
    <p class="language-mark" aria-hidden="true">CATALOG · CATÁLOGO</p>
    <h1 id="language-heading">Choose a catalog language.</h1>
    <p>
      This compatibility route does not redirect or claim to be a localized
      page. Its canonical is
      <a href={localizedCanonical("en", "/catalog/")}>the English catalog</a>.
    </p>
    <ul class="language-options">
      {
        locales.map((locale) => (
          <li>
            <a
              href={localizedHref(locale, "/catalog/")}
              lang={localeDetails(locale).html_lang}
            >
              <span>{localeDetails(locale).label}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
