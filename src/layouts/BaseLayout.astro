---
import "@fontsource-variable/archivo";
import "@fontsource-variable/public-sans";
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import type { Locale } from "../i18n/ui";
import { strings } from "../i18n/ui";
import {
  hreflangUrls,
  localizedHref,
} from "../lib/i18n.mjs";
import { canonicalUrl, withBase } from "../lib/paths.mjs";
import { serializeJsonLd } from "../lib/structured-data.mjs";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  locale?: Locale;
  routeSuffix?: string;
  availableLocales?: Locale[];
  emitAlternates?: boolean;
  noindex?: boolean;
  structuredData?: Array<Record<string, unknown> | null>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  locale,
  routeSuffix = "/",
  availableLocales,
  emitAlternates = true,
  noindex = false,
  structuredData = [],
} = Astro.props;
const preview = import.meta.env.PUBLIC_SITE_ENV === "preview";
const canonical = canonicalUrl(canonicalPath);
const labels = strings(locale ?? "en");
const alternates: Record<string, string> = emitAlternates
  ? hreflangUrls(routeSuffix, availableLocales)
  : {};
const homeHref = locale ? localizedHref(locale, "/") : withBase("/");
const catalogHref = locale
  ? localizedHref(locale, "/catalog/")
  : withBase("/catalog/");
const jsonLd = structuredData.length
  ? serializeJsonLd(structuredData)
  : undefined;
---

<!doctype html>
<html lang={locale ?? "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      Object.entries(alternates).map(([hreflang, href]) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={jsonLd}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skipLink}</a>
    <header class="site-header">
      <a class="wordmark" href={homeHref} aria-label="Awesome LatAm VC home">
        <span aria-hidden="true">A</span>
        <strong>Awesome LatAm VC</strong>
      </a>
      <nav class="primary-navigation" aria-label={labels.primaryNavigation}>
        <a href={homeHref}>{labels.home}</a>
        <a href={catalogHref}>{labels.catalog}</a>
        {
          locale === "en" && (
            <a href={localizedHref(locale, "/about/methodology/")}>
              {labels.editorial}
            </a>
          )
        }
        <a
          href="https://github.com/djairofilho/awesome-latam-vc"
          rel="external"
        >{labels.githubLabel} <span aria-hidden="true">↗</span></a>
      </nav>
      <LanguageSwitcher
        currentLocale={locale}
        routeSuffix={routeSuffix}
        availableLocales={availableLocales}
      />
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>
        {labels.sourceFooter}
        {" "}
        <a href="https://github.com/djairofilho/awesome-latam-vc">GitHub</a>.
      </p>
      <p>{labels.staticFooter}</p>
    </footer>
  </body>
</html>
