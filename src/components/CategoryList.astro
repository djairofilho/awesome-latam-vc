---
import type { Category } from "../lib/catalog";

interface Props {
  counts: Record<Category, number>;
  labels: Record<Category, string>;
  catalogHref: string;
  ariaLabel: string;
}

const { counts, labels, catalogHref, ariaLabel } = Astro.props;
---

<ul class="category-list" aria-label={ariaLabel}>
  {
    Object.entries(labels).map(([category, label], index) => (
      <li>
        <a href={`${catalogHref}#${category}`}>
          <span class="category-number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span>{label}</span>
          <strong>{counts[category as Category]}</strong>
        </a>
      </li>
    ))
  }
</ul>
